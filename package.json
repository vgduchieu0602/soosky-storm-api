{
    "name": "soosky-storm-api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "dist/app.js",
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "test": "tsx --test test/**/*.test.ts",
        "build": "tsc --noEmit && esbuild src/app.ts --bundle --platform=node --format=esm --outfile=dist/app.js --packages=external",
        "start": "node dist/app.js"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "adm-zip": "^0.6.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "fast-xml-parser": "^5.10.1",
        "mongoose": "^9.7.4"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.1",
        "esbuild": "^0.28.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
