# ============================================================
#  STAGING / TEST-MODE env cho Soosky Storm API
#  Copy thành `.env.staging` trên server staging và điền secret.
#  Mục đích: bật endpoint giả lập dissipated (STORM_ALERT_TEST_MODE)
#  MÀ không ảnh hưởng production.
# ============================================================

# --- Port (Docker) ---
# Dùng HOST_PORT KHÁC với production (prod đang là 3001) để 2 container không đụng nhau.
HTTP_PORT=3000
HTTP_HOST=0.0.0.0
HOST_PORT=3003
MEM_LIMIT=400m
NODE_MAX_OLD_SPACE_MB=320
HTTP_TRUST_PROXY=1

# --- Mongo: PHẢI là DB RIÊNG, tuyệt đối không trỏ vào DB production ---
# Đổi tên DB thành soosky_storm_staging (hoặc cluster staging riêng).
# Nếu thiếu `/ten_db` trước `?`, mongoose sẽ ghi vào DB tên "test".
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/soosky_storm_staging?retryWrites=true&w=majority

# --- Rate limit ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=60
RATE_LIMIT_MAX_TRACKED_IPS=10000

# --- CHỐT: bật live + test mode ---
# live = lấy data thật từ NHC/GDACS/OpenWeather (cần mạng + key).
STORM_DATA_MODE=live
NHC_CURRENT_STORMS_URL=https://www.nhc.noaa.gov/CurrentStorms.json
NHC_ATCF_AID_PUBLIC_URL=https://ftp.nhc.noaa.gov/atcf/aid_public
NHC_ATCF_ARCHIVE_URL=https://ftp.nhc.noaa.gov/atcf/archive

# TTL cache: staging dùng cache ngắn cho dễ test (không cần đợi vài giờ).
NHC_CACHE_TTL_MS=600000
ACTIVE_STORMS_CACHE_TTL_MS=600000
HISTORICAL_STORM_TRACK_CACHE_TTL_MS=1200000
FORECAST_WEATHER_CACHE_TTL_MS=1200000
CURRENT_WEATHER_CACHE_TTL_MS=600000
MAP_TILE_CACHE_TTL_MS=1200000
RADAR_CACHE_TTL_MS=1200000

GDACS_GEOMETRY_URL=https://www.gdacs.org/gdacsapi/api/polygons/getgeometry
GDACS_EVENT_LIST_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
GDACS_EVENT_DATA_URL=https://www.gdacs.org/gdacsapi/api/events/geteventdata

OPENWEATHER_API_KEY=your_openweather_api_key

# --- APNs: ĐỂ TRỐNG trên staging ---
# Khi để trống, /v1/notifications/send trả 503 PUSH_NOT_CONFIGURED và KHÔNG gửi
# push thật cho user. Dissipate endpoint vẫn chạy (chỉ không bắn APNs).
# Nếu bắt buộc test push, dùng APNS_ENVIRONMENT=development + p8 của thiết bị test.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_PATH=
APNS_ENVIRONMENT=development

# --- Alert detector ---
# Bật để detector ghi previous state (bắt buộc trước khi /dissipate hoạt động).
ALERTS_ENABLED=true
# Hạ xuống 60s cho staging để detector "nhìn thấy" bão nhanh, tester không phải đợi 15p.
ALERTS_POLL_INTERVAL_MS=60000

# --- Test mode dissipated ---
# true => mount POST /v1/test/storm-alerts/:stormId/dissipate
# Chỉ bật trên staging. Production LUÔN để false.
STORM_ALERT_TEST_MODE=true
