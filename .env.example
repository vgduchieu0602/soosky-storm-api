HTTP_PORT=3000
HTTP_HOST=0.0.0.0

MONGO_URI=mongodb://localhost:27017/soosky-storm-api

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=60
RATE_LIMIT_MAX_TRACKED_IPS=10000
NHC_CURRENT_STORMS_URL=https://www.nhc.noaa.gov/CurrentStorms.json
NHC_ATCF_AID_PUBLIC_URL=https://ftp.nhc.noaa.gov/atcf/aid_public
NHC_CACHE_TTL_MS=7200000
GDACS_GEOMETRY_URL=https://www.gdacs.org/gdacsapi/api/polygons/getgeometry

# OpenWeather One Call 4.0 Forecast Weather and OpenWeather map tiles.
# Set the One Call 4.0 key in .env locally and as a deployment secret in production.
OPENWEATHER_API_KEY=your_openweather_api_key

# NHC, GDACS, and RainViewer public endpoints currently do not require API keys.
