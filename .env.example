# Cong app Node lang nghe. Trong Docker, compose ghi de thanh 3000.
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# Cong Docker publish ra VPS (chi dung khi chay bang docker compose).
# 3000 = soosky-plant-care-api, 3002 = soosky-weather-marine-api.
HOST_PORT=3001

# Tran RAM container va V8 heap. Mac dinh phu hop VPS 1GB.
# VPS 512MB: MEM_LIMIT=320m, NODE_MAX_OLD_SPACE_MB=192
MEM_LIMIT=400m
NODE_MAX_OLD_SPACE_MB=320

# Express "trust proxy" setting. Use 1 behind exactly one reverse proxy.
# Set to false when the API is exposed directly, otherwise X-Forwarded-For
# can be spoofed and the per-IP rate limit bypassed.
HTTP_TRUST_PROXY=1

# PHAI co ten database truoc dau ? -- thieu la du lieu vao database ten "test".
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/soosky_storm?retryWrites=true&w=majority

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=60
RATE_LIMIT_MAX_TRACKED_IPS=10000

NHC_CURRENT_STORMS_URL=https://www.nhc.noaa.gov/CurrentStorms.json
NHC_ATCF_AID_PUBLIC_URL=https://ftp.nhc.noaa.gov/atcf/aid_public
NHC_ATCF_ARCHIVE_URL=https://ftp.nhc.noaa.gov/atcf/archive

# ---- TTL cache in-memory (ms) ----
# TAM THOI dat 10 phut (600000) cho giai doan tester test, rieng forecast 20 phut (1200000).
# Gia tri production cu -- doi lai sau khi test xong:
#   NHC_CACHE_TTL_MS=7200000            (track + cone + spaghetti, 2 gio)
#   ACTIVE_STORMS_CACHE_TTL_MS=3600000  (danh sach bao, 1 gio)
#   HISTORICAL_STORM_TRACK_CACHE_TTL_MS=7200000
#   FORECAST_WEATHER_CACHE_TTL_MS=86400000
#   CURRENT_WEATHER_CACHE_TTL_MS=600000
#   MAP_TILE_CACHE_TTL_MS=43200000
#   RADAR_CACHE_TTL_MS=43200000
NHC_CACHE_TTL_MS=600000
ACTIVE_STORMS_CACHE_TTL_MS=600000
HISTORICAL_STORM_TRACK_CACHE_TTL_MS=600000
FORECAST_WEATHER_CACHE_TTL_MS=1200000
CURRENT_WEATHER_CACHE_TTL_MS=600000
MAP_TILE_CACHE_TTL_MS=600000
RADAR_CACHE_TTL_MS=600000

GDACS_GEOMETRY_URL=https://www.gdacs.org/gdacsapi/api/polygons/getgeometry
GDACS_EVENT_LIST_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
GDACS_EVENT_DATA_URL=https://www.gdacs.org/gdacsapi/api/events/geteventdata

# OpenWeather One Call 4.0 Forecast Weather and OpenWeather map tiles.
# Set the One Call 4.0 key in .env locally and as a deployment secret in production.
OPENWEATHER_API_KEY=your_openweather_api_key

# NHC, GDACS, and RainViewer public endpoints currently do not require API keys.

# Apple Push Notification service. Leave blank to disable /v1/notifications/send,
# which then answers 503 PUSH_NOT_CONFIGURED without affecting other endpoints.
# The .p8 key file must never be committed.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
# Duong dan TRONG CONTAINER (docker compose mount ./secrets/apns vao day).
APNS_PRIVATE_KEY_PATH=/run/secrets/apns/AuthKey_XXXXXXXXXX.p8
APNS_ENVIRONMENT=development

# Automatic storm alert detection. Set ALERTS_ENABLED=false to keep the API running
# without any background polling or push delivery.
ALERTS_ENABLED=true
ALERTS_POLL_INTERVAL_MS=900000
