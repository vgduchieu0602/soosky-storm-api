    {
      "name": "Devices & Subscriptions",
      "item": [
        {
          "name": "Register device",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok = true', () => pm.expect(pm.response.json().ok).to.eql(true));",
                  "const d = pm.response.json().data;",
                  "pm.test('registered = true', () => pm.expect(d.registered).to.eql(true));",
                  "pm.test('khong tra lai deviceToken', () => pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('deviceToken')));",
                  "console.log('alreadyRegistered:', d.alreadyRegistered);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
