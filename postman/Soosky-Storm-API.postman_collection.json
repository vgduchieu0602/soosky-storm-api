        {
          "id": "4ab9e6fb-694c-4651-8429-76cf5d512575",
          "name": "History track - AL052025 Erin (68 diem)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('availability = available', () => pm.expect(d.availability).to.eql('available'));",
                  "pm.test('co it nhat 60 diem', () => pm.expect(d.history.length).to.be.at.least(60));",
                  "pm.test('diem co windSpeed va category thuc', () => {",
                  "    pm.expect(d.history[0].windSpeed).to.be.a('number');",
                  "    pm.expect(d.history[0].category).to.not.eql('unknown');",
                  "});",
                  "console.log(d.history.length + ' diem | ' + d.history[0].datetime + ' -> ' + d.history.at(-1).datetime);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/storms/nhc:AL052025/history-track",
            "description": "Bao da ket thuc, doc tu NHC ATCF archive B-deck. Data co san BAT KE co bao active hay khong."
