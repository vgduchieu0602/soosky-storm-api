    {
      "id": "930797b2-09ed-4bd4-88fd-f769ce9a62c3",
      "name": "Notifications",
      "item": [
        {
          "id": "077a9d04-5c18-4125-8c89-4f3c2f01c1fc",
          "name": "Send push notification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// deviceToken mac dinh la GIA -> APNs tra 400 INVALID_DEVICE_TOKEN. Day la DUNG.",
                  "pm.test('status 200 / 400 / 503', () => pm.expect([200, 400, 503]).to.include(pm.response.code));",
                  "const b = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "    pm.test('sent = true', () => pm.expect(b.data.sent).to.eql(true));",
                  "} else {",
                  "    console.log('code:', b.code, '-', b.reason);",
                  "}",
                  "pm.test('khong lo credentials', () => {",
                  "    const t = pm.response.text();",
                  "    ['BEGIN PRIVATE KEY', 'bearer ', 'InvalidProviderToken'].forEach((s) => pm.expect(t).to.not.include(s));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceToken\": \"{{deviceToken}}\",\n  \"title\": \"Storm Warning\",\n  \"description\": \"Hurricane Erin may affect your area.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/notifications/send",
            "description": "Đổi biến deviceToken thành token thật từ app iOS để gửi push thật. 503 = thiếu biến APNS_* hoặc sai đường dẫn .p8."
          },
          "response": []
