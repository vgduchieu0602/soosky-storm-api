      "item": [
        {
          "id": "4ab704d6-7522-4f93-8d7d-88860d129280",
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('tra ve JSON, khong phai HTML', () => {",
                  "    pm.expect(pm.response.headers.get('content-type') || '').to.include('json');",
                  "});",
                  "const d = pm.response.json().data;",
                  "pm.test('dung service', () => pm.expect(d.service).to.eql('soosky-storm-api'));",
                  "pm.test('database connected', () => pm.expect(d.database).to.eql('connected'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Nếu trả về HTML thay vì JSON: nginx đang route sang project khác. Xem lại server_name/cert của domain đang gọi."
          },
          "response": []
        }
      ]
    },
